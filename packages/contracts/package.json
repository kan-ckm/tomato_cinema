{
  "name": "@tomatocinema/contracts",
  "version": "1.0.4",
  "description": "dịch vụ biên dịch protobuf sang dạng mã typescript",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./gen/ts/*": {
      "types": "./dist/gen/ts/*.d.ts",
      "default": "./dist/gen/ts/*.js"
    },
    "./gen/*": {
      "types": "./dist/gen/ts/*.d.ts",
      "default": "./dist/gen/ts/*.js"
    }
  },
  "scripts": {
    "build": "pnpm generate && tsc -p tsconfig.build.json",
    "generate": "protoc -I ./proto ./proto/*.proto --ts_proto_out=./gen/ts --ts_proto_opt=nestJs=true,package=omit && sh ./src/scripts/generate_go.sh"
  },
  "files": [
    "proto",
    "gen",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@nestjs/microservices": "^11.1.28",
    "rxjs": "^7.8.1",
    "ts-proto": "^2.12.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  }
}