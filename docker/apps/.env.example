# =
# BIẾN MÔI TRƯỜNG MICROSERVICES (APPS) - docker/apps/.env
# Áp dụng cho: auth-service, user-service, gateway-service, notification-service, bot-service
# =

# Môi trường chung
NODE_ENV=

# --- Kết nối PostgreSQL (trỏ vào container postgres trong cùng network) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
DATABASE_LOGGING=
DATABASE_SYNC=

# --- Kết nối Redis ---
REDIS_USER=
REDIS_PASSWORD=
REDIS_PORT=

# --- Kết nối RabbitMQ ---
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASSWORD=
RABBITMQ_PORT=
RMQ_QUEUE=

# --- gRPC Internal Ports ---
AUTH_GRPC_PORT=
USER_GRPC_PORT=

# --- Gateway HTTP & CORS ---
GATEWAY_HTTP_PORT=
HTTP_HOST=
HTTP_CORS=
COOKIE_DOMAIN=
COOKIE_SECRET=

# --- Security & JWT Passport (giây: 3600=
PASSPORT_SECRET_KEY=
PASSPORT_ACCESS_TTL=
PASSPORT_REFRESH_TTL=

# --- Telegram Bot ---
TELEGRAM_BOT_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_REDIRECT_ORIGIN=

# --- Notification & SMTP (Mailtrap Sandbox cho Dev) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_SECURE=
EXOLVE_API_KEY=
EXOLVE_SENDER=
