{
  "name": "@tomatocinema/contracts",
  "version": "1.0.3",
  "description": "dịch vụ biên dịch protobuf sang dạng mã typescript",
  "scripts": {
    "generate":"protoc -I ./proto ./proto/*.proto --ts_proto_out=./gen --ts_proto_opt=nestJs=true,package=omit"
  },
  "files": [
    "proto",
    "gen"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "ts-proto": "^2.12.0"
  }
}
