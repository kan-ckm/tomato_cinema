# =
# BIẾN MÔI TRƯỜNG MICROSERVICES (APPS) - docker/apps/.env
# Áp dụng cho: auth-service, user-service, gateway-service, notification-service, bot-service
# =

# Môi trường chung
NODE_ENV=

# --- Kết nối PostgreSQL (trỏ vào container postgres trong cùng network) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
DATABASE_LOGGING=
DATABASE_SYNC=

# --- Kết nối Redis ---
REDIS_USER=
REDIS_PASSWORD=
REDIS_PORT=

# --- Kết nối RabbitMQ ---
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASSWORD=
RABBITMQ_PORT=
RMQ_QUEUE=

# --- gRPC Internal Ports ---
AUTH_GRPC_PORT=
USER_GRPC_PORT=

# --- Gateway HTTP & CORS ---
GATEWAY_HTTP_PORT=
NGINX_HTTP_PORT=
HTTP_HOST=
HTTP_CORS=
COOKIE_DOMAIN=
COOKIE_SECRET=

# --- Security & JWT Passport (giây: 3600 = 1 giờ) ---
PASSPORT_SECRET_KEY=
PASSPORT_ACCESS_TTL=
PASSPORT_REFRESH_TTL=

# --- Telegram Bot ---
TELEGRAM_BOT_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_REDIRECT_ORIGIN=

# --- Notification & SMTP (Mailtrap Sandbox cho Dev) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_SECURE=
EXOLVE_API_KEY=
EXOLVE_SENDER=

# --- Media Service (Go) & Cloudflare R2 ---
MEDIA_APP_ENV=production
MEDIA_HTTP_PORT=4200
MEDIA_GRPC_PORT=50059
MEDIA_GRPC_MAX_MSG_MB=16
MEDIA_PUBLIC_URL=http://localhost:8080/media
MEDIA_LOG_LEVEL=info
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=
