{
  "dependencies": {
    "@nestjs/mapped-types": "*"
  },
  "name": "tomato-cinema",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/kan-ckm/tomato_cinema.git"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm format && turbo run dev",
    "debug": "turbo run debug",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "homelab:up": "./scripts/homelab/run.sh up",
    "homelab:down": "./scripts/homelab/run.sh down",
    "homelab:restart": "./scripts/homelab/run.sh restart",
    "homelab:logs": "./scripts/homelab/run.sh logs",
    "homelab:ps": "./scripts/homelab/run.sh ps",
    "homelab:sync": "./scripts/homelab/run.sh sync"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.10.7",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
