# --- Môi trường chung ---
APP_ENV='development' # 'development' hoặc 'production'

# --- HTTP Server (Xem ảnh trực tiếp) ---
HTTP_PORT=4200        # Cổng lắng nghe HTTP của Gin
HTTP_HOST='localhost:4200' # Domain/Host dùng để sinh public link cho Frontend

# --- gRPC Server (Upload/Delete nội bộ giữa các microservices) ---
GRPC_PORT=50059       # Cổng tiếp nhận RPC
GRPC_HOST='localhost' # Host lắng nghe RPC

# --- Cấu hình Storage (Tương thích AWS S3, MinIO, Cloudflare R2) ---
S3_DRIVER='s3'
S3_BUCKET='tomato-cinema-media' # Tên bucket lưu trữ
S3_REGION='us-east-1'           # Khu vực S3 (ví dụ: us-east-1)
S3_ENDPOINT=''                  # Để trống nếu dùng AWS S3 thật; điền 'http://minio:9000' nếu dùng MinIO local
S3_ACCESS_KEY=''                # Access key của S3 / MinIO
S3_SECRET_KEY=''                # Secret key của S3 / MinIO
S3_PUBLIC_URL=''                # Tùy chọn: URL công khai hoặc CDN domain trỏ vào bucket

# --- Cấu hình Bộ ghi log ---
LOG_LEVEL='debug'     # 'debug', 'info', 'warn', 'error', 'fatal'
